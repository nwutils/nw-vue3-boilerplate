{
  "ManifestComments": [
    "Only add dependencies that you want shipped to the end user, for everything else, use devDependencies, including things that will be bundled by Vite.",
    "NW.js requires a name and a main, everything else is optional.",
    "To turn spell checking off, remove it from the chromium-args in this file"
  ],
  "name": "your-app-name",
  "version": "2.1.0",
  "main": "http://localhost:4175",
  "node-remote": "http://localhost:4175",
  "node-main": "",
  "window": {
    "width": 960,
    "height": 600,
    "min_width": 800,
    "min_height": 500,
    "icon": "public/icon.png"
  },
  "private": true,
  "scripts": {
    "postinstall": "npx --yes base-volta-off-of-nwjs@latest",
    "start": "concurrently -k npm:dev:web npm:dev:desktop",
    "dev:web": "vite --port 4175",
    "dev:desktop": "wait-on -c waitOnConfig.json http-get://localhost:4175 && nw .",
    "build": "npm run build:clean && npm run build:vue && npm run build:nw",
    "build:clean": "rimraf ./dist-vue ./dist",
    "build:vue": "vite build",
    "build:nw": "node ./scripts/build.js",
    "build:run": "./dist/your-app-name-2.1.0/your-app-name",
    "regression": "rm -r -f node_modules && npm install && npm run lint && npm test && npm run build && npm run build:run",
    "lint": "eslint --ext .js,.vue src tests scripts",
    "fix": "npm run lint -- --fix",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-tjw-base": "^5.0.0",
    "eslint-config-tjw-import-x": "^1.0.1",
    "eslint-config-tjw-jest": "^4.0.0",
    "eslint-config-tjw-vue": "^4.0.1",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "nw": "0.117.0-sdk",
    "nw-builder": "^4.21.4",
    "pinia": "^4.0.0",
    "rimraf": "^6.1.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-dev-tools-accessibility": "^0.5.6",
    "vue-options-api-constants-plugin": "^1.0.3",
    "vue-router": "^5.4.0",
    "vue3-snapshot-serializer": "^2.13.4",
    "wait-on": "^9.5.1"
  },
  "chromium-args": "--enable-spell-checking --disable-features=ProcessPerSiteUpToMainFrameThreshold",
  "type": "module",
  "volta": {
    "node": "26.7.0"
  }
}
